# CLion 설정에서 .clang-format 활성화 하기
# Settings → Editor → Code Style → Enable ClangFormat 체크
# Settings → Editor → Inspections → C/C++ → General → Clang-Tidy 에서 prefer ~~ 이 파일을 우선시 하는 체크 활성화하기
# 적용후 Clion 모든 캐시 지우고 재시작 필요


# .clang-format
BasedOnStyle: LLVM

# 들여쓰기
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4          # public:/private: 들여쓰기 보정

# 줄 길이
ColumnLimit: 90

# .clang-format: 문자열은 절대 안 쪼갬 (90자를 넘어도 그대로 둠)
BreakStringLiterals: false

# 중괄호 스타일
BreakBeforeBraces: Attach          # 여는 중괄호를 같은 줄에 (K&R 스타일)

# 포인터/레퍼런스 정렬
PointerAlignment: Left             # int* p  (오른쪽 정렬 원하면 Right)
ReferenceAlignment: Left

# 공백
SpaceBeforeParens: ControlStatements   # if (x) 처럼 제어문에만 공백
SpacesInAngles: false                  # std::vector<int> (공백 없음)

# 정렬
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments: true

# 네임스페이스
NamespaceIndentation: All
FixNamespaceComments: true     # 닫는 } 뒤에 // namespace xxx 자동 추가 (LLVM 기본값이지만 명시)
ShortNamespaceLines: 0         # 기본 1: 본문이 1줄 이하면 주석 생략 → 0이면 항상 붙임

# include 정렬: 자기 헤더 → 표준 → 외부 라이브러리 → 프로젝트
SortIncludes: true
IncludeBlocks: Regroup
IncludeIsMainRegex: '$'      # foo.cpp ↔ foo.hpp 만 자기 헤더로 인정
IncludeCategories:
  # 1. 표준 라이브러리: 확장자, 폴더 없는 <vector>, <cstdint>, <unordered_map>
  -   Regex: '^<[a-z_0-9]+>$'
      Priority: 1
  # 2. 외부 라이브러리: 나머지 <...> (gtest, glm, fmt, windows.h ...)
  -   Regex: '^<'
      Priority: 2
  # 3. 프로젝트: "..."
  -   Regex: '^"'
      Priority: 3


# 파라미터
BinPackParameters: false  #파라미터를 여러줄 가능하게 다
AllowAllParametersOfDeclarationOnNextLine: true
AlignAfterOpenBracket: AlwaysBreak

# 브레이스
InsertBraces: true # if문등 {} 기본으로 입력해주기

# 기타
Standard: c++20

# 빈 함수 {} 만 한 줄 허용
AllowShortFunctionsOnASingleLine: Empty
